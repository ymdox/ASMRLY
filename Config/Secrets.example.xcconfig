// Copy this file to Config/Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is git-ignored. Leave any value empty to use the
// built-in mock AI / Apple voice fallback — the app works with zero keys.
//
// NOTE: in .xcconfig files "//" starts a comment, so values must not contain it.
//
// For production, API keys must live on a backend you control, not in the
// app binary. Embedding them here is acceptable for this MVP only.

OPENAI_API_KEY =
// Optional: override the chat model (defaults to gpt-4o-mini).
OPENAI_MODEL =

ELEVENLABS_API_KEY =
ELEVENLABS_VOICE_ID =
